    "sharp": "^0.35.5",
    "ws": "^8.18.0",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@types/ws": "^8.5.12",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1"
  }
}
