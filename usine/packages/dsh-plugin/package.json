{
  "name": "@feuille/dsh-plugin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "feuille 的 dsh（DeepSeek Harness，钉 dsh-v0.1.7-rc.2 本地 checkout）原生智能体插件：全量工具面（进程内直调 @feuille/* 包 main，无 subprocess 桥）+ 红线机制承载（video-generation 每次 approval fail-closed、publish 默认不注册 config 显式开启）+ systemPrompt 纪律节。dsh 进程无 TS 变换钩子，本包 esbuild 打包出单文件 dist/index.mjs 供 cordis loader 加载。",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=esm --platform=node --external:sharp --external:@napi-rs/canvas --external:ws --external:playwright --outfile=dist/index.mjs"
  },
  "dependencies": {
    "@feuille/core": "workspace:*",
    "@napi-rs/canvas": "^1.0.11",
    "sharp": "^0.35.5",
    "ws": "^8.18.0",
    "@feuille/copy": "workspace:*",
    "@feuille/bgm": "workspace:*",
    "@feuille/karaoke": "workspace:*",
    "@feuille/poetry": "workspace:*",
    "@feuille/poster": "workspace:*",
    "@feuille/storyteller": "workspace:*",
    "@feuille/publish": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:../../../../../deepseek-harness/vendor/cordis",
    "@deepseek-ai/dsh-tools": "link:../../../../../deepseek-harness/packages/core/tools",
    "@feuille/cli": "workspace:*",
    "esbuild": "^0.25.0"
  }
}
