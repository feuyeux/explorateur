# 产线中间产物与可再生工程文件：都能由 data/ + tools/ 一键再生，不入库
# （纪律：可再生产物不入库；入库的是事实源、生成器与最终成片）

# 状态帧（每次渲染上千张 PNG）
episodes/*/frames/
episodes/*/frames_v/

# TTS 中间件（mp3 + 词边界 json，可由 voices.json 重跑再生）
episodes/*/tts/

# 人工看帧的证据目录
episodes/*/qa/

# 生成的工程文件（scene HTML / 配音清单 / 成片配置 / 封面源 / 组装件）
episodes/*/video_src.html
episodes/*/video_build.html
episodes/*/voices.json
episodes/*/video.json
episodes/*/cover_*_src.html
episodes/*/concat_v.txt
episodes/*/concat_a.txt

# 字体子集（fonts.json 是规格；fonts.css 由 fetch-fonts 联网重生成，930KB base64）
fonts.css

# 诊断脚本的临时产物（.mts/.ts 都要盖住——只写 .mts 时 dbg-boundaries.ts 会漏进索引）
tools/dbg-*.mts
tools/dbg-*.ts
episodes/*/probe*.png
episodes/*/probe*.html
episodes/*/dbg*.png
episodes/*/dbg*.png.probe.html
episodes/*/_vp_probe.html
episodes/*/d[0-9].png
episodes/*/m[0-9].png
episodes/*/r[0-9].png
episodes/*/x[0-9].png

# 抽帧工具的跨支临时产物（每支的证据在 episodes/*/qa/，可由成片重抽）
qa_shot/

# 批产日志与汇总（可由 build-all 重跑再生）
build-batch.log
build-summary.json
