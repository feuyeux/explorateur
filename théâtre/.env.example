# Copy to .env and supply your own credential. Never commit .env.
OPENROUTER_API_KEY=

# Optional rerouting without OpenRouter. Without these the transport targets
# https://openrouter.ai/api/v1 byte-identically to the historical client:
# RSIAGENT_LLM_BASE_URL=https://your-openai-compatible-gateway/v1
# RSIAGENT_LLM_API_KEY=
# Per-model endpoints (JSON: {"<model>": {"base_url": ..., "api_key": ...}});
# keep the file outside any repository — it holds credentials:
# RSIAGENT_LLM_ENDPOINTS_FILE=/absolute/private/path/llm-endpoints.json

# Paths default to this checkout and its sibling OSWorld-V2.
# Export path overrides in your shell before invoking a runner:
# RSIAGENT_ROOT=/absolute/path/to/RSIAgent
# OSWORLD_ROOT=/absolute/path/to/OSWorld-V2
# RSIAGENT_ENV_FILE=/absolute/private/path/rsi.env
