{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HummingScore",
  "version": "1.0.0",
  "identifier": "com.hummingscore.studio",
  "build": {
    "beforeDevCommand": "node scripts/clean_bundle_state.mjs && node scripts/build_vendor.mjs",
    "beforeBuildCommand": "node scripts/clean_bundle_state.mjs && node scripts/build_vendor.mjs",
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "哼唱识谱 (Humming to Score)",
        "width": 1280,
        "height": 880,
        "minWidth": 940,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-eval' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; media-src 'self' blob: data:; connect-src 'self' data: blob:; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "HummingScore",
    "category": "Music",
    "shortDescription": "哼唱识谱 / Humming to Score",
    "longDescription": "将哼唱录音实时转换为五线谱、简谱、MIDI 与 MusicXML 的跨平台桌面应用",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}